local autoDeleteEnabled = false
local autoDeleteConnection = nil
local totalDeleted = 0

local function getMyVehicle()
    local char = player.Character
    if not char then return nil end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.SeatPart then
        return humanoid.SeatPart:FindFirstAncestorOfClass("Model")
    end
    return nil
end

local function isAICar(model)
    if not model:IsA("Model") then return false end
    
    local myCar = getMyVehicle()
    if myCar and model == myCar then return false end
    
    for _, otherPlayer in pairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            local otherChar = otherPlayer.Character
            if otherChar then
                local humanoid = otherChar:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.SeatPart then
                    local theirCar = humanoid.SeatPart:FindFirstAncestorOfClass("Model")
                    if theirCar and model == theirCar then
                        return false
                    end
                end
            end
        end
    end
    
    local hasVehicleSeat = model:FindFirstChildOfClass("VehicleSeat") ~= nil
    local hasDriveSeat = model:FindFirstChild("DriveSeat") ~= nil
    local hasSeat = model:FindFirstChildOfClass("Seat") ~= nil
    
    if not (hasVehicleSeat or hasDriveSeat or hasSeat) then return false end
    
    local hasWheels = false
    local hasBody = false
    
    for _, part in pairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            local name = part.Name:lower()
            if name:find("wheel") or name:find("rueda") or name:find("tire") or name:find("llanta") then
                hasWheels = true
            end
            if name:find("body") or name:find("chassis") or name:find("car") or name:find("auto") then
                hasBody = true
            end
        end
    end
    
    if hasVehicleSeat or hasDriveSeat then
        return true
    end
    
    if hasWheels and hasSeat then
        return true
    end
    
    return false
end

local function deleteAICars()
    local deleted = 0
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            if isAICar(obj) then
                pcall(function()
                    obj:Destroy()
                    deleted = deleted + 1
                end)
            end
        end
    end
    
    totalDeleted = totalDeleted + deleted
    return deleted
end

local function deleteByName()
    local deleted = 0
    local namesToDelete = {
        "Traffic", "NPC", "Bot", "AI", "TrafficCar", "NPCCar", "AICar",
        "CarAI", "VehicleAI", "AutoCar", "DummyCar", "Taxi", "PoliceAI",
        "TrafficVehicle", "SpawnedCar", "GeneratedCar"
    }
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("Folder") then
            local name = obj.Name:lower()
            for _, targetName in pairs(namesToDelete) do
                if name:find(targetName:lower()) then
                    local myCar = getMyVehicle()
                    if obj ~= myCar then
                        pcall(function()
                            obj:Destroy()
                            deleted = deleted + 1
                        end)
                    end
                    break
                end
            end
        end
    end
    
    return deleted
end

DeleteBtn.MouseButton1Click:Connect(function()
    InfoLabel.Text = "Procesando..."
    
    local deleted1 = deleteAICars()
    local deleted2 = deleteByName()
    local total = deleted1 + deleted2
    
    InfoLabel.Text = string.format("Eliminados: %d | Completado: %d vehículos", totalDeleted, total)
    
    DeleteBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
    wait(0.2)
    DeleteBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
end)

AutoBtn.MouseButton1Click:Connect(function()
    autoDeleteEnabled = not autoDeleteEnabled
    
    if autoDeleteEnabled then
        AutoBtn.Text = "Limpieza automática: Activada"
        AutoBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
        
        autoDeleteConnection = RunService.Heartbeat:Connect(function()
            local deleted = deleteAICars()
            if deleted > 0 then
                totalDeleted = totalDeleted + deleted
                InfoLabel.Text = string.format("Eliminados: %d | Automático activo", totalDeleted)
            end
        end)
    else
        AutoBtn.Text = "Limpieza automática: Desactivada"
        AutoBtn.TextColor3 = Color3.fromRGB(100, 150, 255)
        
        if autoDeleteConnection then
            autoDeleteConnection:Disconnect()
            autoDeleteConnection = nil
        end
        
        InfoLabel.Text = string.format("Eliminados: %d | Pausado", totalDeleted)
    end
end)

CloseX.MouseButton1Click:Connect(function()
    autoDeleteEnabled = false
    if autoDeleteConnection then
        autoDeleteConnection:Disconnect()
    end
    ScreenGui:Destroy()
end)

